datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  OWNER
  EMPLOYEE
  VENDOR
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  BOOKED
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  SETTLED
  EXPIRED
  CANCELLED
  FAILED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Channel {
  WHATSAPP
  EMAIL
  IN_APP
}

model Property {
  id         String     @id @default(uuid())
  name       String
  slug       String?    @unique
  address    String
  city       String
  mapsUrl    String?
  photos     String[]
  totalRooms Int
  ownerName  String?
  ownerPhone String?
  description String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  rooms      Room[]
  users      User[]
  faqEntries FaqEntry[]
  expenses   Expense[]
  surveys    SurveySchedule[]
}

model FaqEntry {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  question   String
  answer     String
  category   String // jam_operasional, check_in, parkir, pembayaran
  createdAt  DateTime @default(now())
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  phone        String
  passwordHash String
  role         Role              @default(TENANT)
  avatar       String?
  avatarUrl    String?
  propertyId   String?
  property     Property?         @relation(fields: [propertyId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  rooms        Room[]            @relation("RoomTenant")
  invoices     Invoice[]
  complaints   Complaint[]
  notifications NotificationLog[]
}

model Room {
  id         String     @id @default(uuid())
  number     String     @unique
  type       String // Standard, Deluxe, VIP
  price      Float
  status     RoomStatus @default(AVAILABLE)
  floor      Int        @default(1)
  capacity   Int        @default(1)
  facilities String[] // AC, WiFi, KM Dalam, TV
  imageUrl   String? // Foto kamar (base64 atau URL)
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id])
  tenantId   String?
  tenant     User?      @relation("RoomTenant", fields: [tenantId], references: [id])
  invoices   Invoice[]
  complaints Complaint[]
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  amount        Float
  penaltyAmount Float         @default(0)
  totalAmount   Float
  dueDate       DateTime
  paymentStatus PaymentStatus @default(PENDING)
  orderId       String?       @unique
  snapToken     String?
  paymentType   String?
  vaNumber      String?
  settledAt     DateTime?
  paymentLogs   PaymentLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PaymentLog {
  id                String   @id @default(uuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  rawPayload        Json
  transactionStatus String
  statusCode        String
  createdAt         DateTime @default(now())
}

model Complaint {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  roomId      String?
  room        Room?           @relation(fields: [roomId], references: [id])
  title       String
  description String
  category    String          @default("lain_lain") // Plumbing, Electrical, Furniture, Internet
  imageUrl    String?
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model NotificationLog {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  title   String
  message String
  channel Channel  @default(IN_APP)
  sentAt  DateTime @default(now())
  isRead  Boolean  @default(false)
}

model Expense {
  id          String    @id @default(uuid())
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  category    String    // listrik, air, perbaikan, internet, lain_lain
  amount      Float
  description String
  receiptUrl  String?
  ocrRaw      Json?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model Booking {
  id              String    @id @default(uuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])
  tenantName      String
  tenantEmail     String?
  tenantPhone     String
  tenantIdNumber  String?   // KTP/SIM number
  checkInDate     DateTime
  contractEnd     DateTime?
  rentalDuration  Int       @default(1) // months
  dpAmount        Float
  dpOrderId       String?
  dpSnapToken     String?
  notes           String?
  status          String    @default("PENDING_DP") // PENDING_DP, CONFIRMED, CANCELLED, CHECKED_IN
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomId, status])
}

model Conversation {
  id        String   @id @default(uuid())
  phone     String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone])
}

model StockOpnameAudit {
  id            String   @id @default(uuid())
  itemName      String
  category      String
  systemStock   Int
  physicalStock Int
  discrepancy   Int
  photoUrl      String?
  watermarkText String?
  geoLat        Float?
  geoLng        Float?
  auditedBy     String
  branchId      String   @default("all")
  createdAt     DateTime @default(now())

  @@index([branchId, createdAt])
}

model SupplyOrder {
  id            String   @id @default(uuid())
  tenantName    String
  roomNumber    String
  category      String   @default("CUSTOM")
  item          String
  notes         String?
  status        String   @default("PENDING_DISPATCH")
  assignedStaff String?
  vendorName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

model SurveySchedule {
  id           String    @id @default(uuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id])
  roomId       String?
  prospectName String
  prospectPhone String
  prospectEmail String?
  scheduledAt  DateTime
  notes        String?
  status       String    @default("PENDING") // PENDING, CONFIRMED, DONE, CANCELLED
  surveyType   String    @default("ONSITE")  // ONSITE, VIDEO_CALL
  handledBy    String?   // staff name/id
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([propertyId, scheduledAt])
  @@index([status])
}

model OperationalReserve {
  id          String   @id @default(uuid())
  propertyId  String
  month       Int      // 1-12
  year        Int
  targetAmount Float
  currentAmount Float  @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, month, year])
}
